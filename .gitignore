# ===================================================================
# Универсальный .gitignore для учебного репозитория ITMO
#
# Включает правила для:
# - Операционных систем (Windows, macOS, Linux)
# - Популярных IDE и редакторов (VS Code, JetBrains, etc.)
# - Множества языков программирования (Python, C/C++, Java, JS, etc.)
# - Игнорирование всех файлов и папок, начинающихся с точки.
# - Игнорирование бинарных файлов, документов и секретов.
# ===================================================================

# --- Главное правило: Игнорировать все файлы и папки, начинающиеся с точки ---
# Это покрывает конфигурации IDE, кэши и прочие служебные файлы.
.*
.*/

# --- Исключения: НЕ игнорировать важные dot-файлы ---
# Позволяет хранить в репозитории сам .gitignore и настройки Git.
!/.gitignore
!/.gitattributes
!/.gitmodules

# ===================================================================
# Файлы операционных систем
# ===================================================================

# --- Windows ---
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
~*

# --- macOS ---
.DS_Store
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes
__MACOSX

# --- Linux ---
*~
.directory

# ===================================================================
# IDE и редакторы кода
# ===================================================================

# --- Visual Studio Code ---
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# --- JetBrains (PyCharm, IntelliJ, CLion, WebStorm, etc.) ---
.idea/
*.iml
*.iws

# --- Sublime Text ---
*.sublime-project
*.sublime-workspace

# --- Eclipse ---
.metadata
.classpath
.project
.settings/
*.tmp

# --- NetBeans ---
nbproject/
build/
nbbuild/
dist/
nbdist/

# --- Vim ---
*.swp

# ===================================================================
# Языки программирования и фреймворки
# ===================================================================

# --- Python ---
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
/venv/
/env/
.pytest_cache/
.tox/
pip-log.txt
pip-delete-this-directory.txt
.eggs/
*.egg-info/

# --- C / C++ ---
# Исполняемые файлы и библиотеки
# *.exe
*.out
*.app
*.dll
*.so
*.lib
*.a
# Объектные файлы и временные файлы компиляции
*.o
*.obj
*.pch
*.suo
*.ilk
*.pdb
# Папки с результатами сборки
bin/
Debug/
Release/

# --- Java ---
*.class
*.jar
*.war
*.ear
/target/
hs_err_pid*.log

# --- JavaScript / Node.js ---
# Никогда не добавляйте в репозиторий эту папку!
node_modules/
# Логи
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# Сборки
.dist/

# --- C# / .NET ---
obj/
*.user
*.userosscache
*.sln.docstates

# --- LaTeX ---
# Временные файлы, создаваемые при компиляции
*.aux
*.bbl
*.blg
*.log
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz
*.toc

# ===================================================================
# Секреты, конфигурации и чувствительные данные
# ===================================================================
# Никогда не храните пароли, API-ключи и другие секреты в Git!

# Переменные окружения
.env
.env.local
.env.*.local
!.env.example
!.env.template

# Приватные ключи и сертификаты
*.pem
*.key
*.p12
*.pfx
*.asc

# Файлы конфигурации облачных провайдеров
.terraform/
*.tfstate
*.tfstate.*
.aws/
.gcp/
*credentials*.*

# Дампы баз данных (могут содержать PII)
*.sql
*.dump
*.bak
*.backup

# Файлы с учетными данными
*.htpasswd

# ===================================================================
# Прочее
# ===================================================================

# --- Лог-файлы ---
logs/
*.history

# --- Сжатые архивы ---
*.zip
*.rar
*.7z
*.tar
*.gz

# --- Документация и бинарные форматы ---

*.doc

*.ppt

*.xls
# Файлы дизайна и изображений, если они не являются частью исходных ассетов
*.psd
*.ai
*.fig


# IDA Pro temporary files
*.idb
*.i64
*.id0
*.id1
*.id2
*.id3
*.til
*.nam
*.idc
*.idc.bak

# Backup и autosave
*.idb.bak
*.i64.bak
*.id0.bak
*.id1.bak
*.id2.bak
*.id3.bak

# Папки проектов IDA
*.idaproj/
*.i64p/
